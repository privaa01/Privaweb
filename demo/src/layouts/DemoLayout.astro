---
import Layout from '../../../src/layouts/PublicLayout.astro';
const {title,pageId}=Astro.props;
---
<Layout title={title} pageId={pageId} contentLayout="full" noReferrer>
 <aside class="demo-notice" aria-label="Estado de la demostración"><strong>Demo pública de Priva.</strong> Historias educativas y presentación del prototipo. Contacto permite guardar únicamente pruebas ficticias en Firestore.</aside>
 <slot />
 <footer slot="footer" class="demo-footer"><p>Priva · Demostración educativa</p><nav aria-label="Enlaces complementarios"><a href="/terminos.html">Términos de la demo</a> · <a href="/manifiesto-datos.html">Privacidad de la demo</a> · <a href="/contacto.html">Contacto</a></nav></footer>
</Layout>
<style>.demo-notice{padding:1rem 1.5rem;background:#e4f3eb;color:#123c2d;border-bottom:1px solid #406b59;overflow-wrap:anywhere}.demo-footer{padding:2rem;background:#102e23;color:white}.demo-footer a{color:white;display:inline-block;padding:.5rem}</style>
