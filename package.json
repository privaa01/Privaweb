{
  "name": "privaweb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "node scripts/require-documents-publication.mjs && node scripts/require-pages.mjs && node scripts/require-home-publication.mjs && node scripts/require-stories-publication.mjs && node scripts/require-app-publication.mjs && node scripts/require-contact-publication.mjs && node scripts/require-admin-publication.mjs && node scripts/require-story-management-publication.mjs && node scripts/require-inbox-publication.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build && npm run build:admin:views",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check:contract": "ASTRO_TELEMETRY_DISABLED=1 astro check --root tests/fixtures/navigation",
    "build:contract": "ASTRO_TELEMETRY_DISABLED=1 astro build --root tests/fixtures/navigation",
    "test:e2e:contract": "playwright test",
    "test:e2e:integration": "PRIVA_TEST_MODE=integration playwright test",
    "check:home:contract": "ASTRO_TELEMETRY_DISABLED=1 astro check --root tests/fixtures/home",
    "build:home:contract": "ASTRO_TELEMETRY_DISABLED=1 astro build --root tests/fixtures/home",
    "test:e2e:home:contract": "playwright test --config=playwright.home.config.ts",
    "test:e2e:home:integration": "PRIVA_TEST_MODE=integration playwright test --config=playwright.home.config.ts",
    "check:stories:contract": "ASTRO_TELEMETRY_DISABLED=1 astro check --root tests/fixtures/stories",
    "build:stories:contract": "ASTRO_TELEMETRY_DISABLED=1 astro build --root tests/fixtures/stories",
    "test:e2e:stories:contract": "playwright test --config=playwright.stories.config.ts",
    "test:e2e:stories:integration": "PRIVA_TEST_MODE=integration playwright test --config=playwright.stories.config.ts",
    "check:app:contract": "ASTRO_TELEMETRY_DISABLED=1 astro check --root tests/fixtures/app",
    "build:app:contract": "ASTRO_TELEMETRY_DISABLED=1 astro build --root tests/fixtures/app",
    "test:e2e:app:contract": "playwright test --config=playwright.app.config.ts",
    "test:e2e:app:integration": "PRIVA_TEST_MODE=integration playwright test --config=playwright.app.config.ts",
    "check:contact:service": "tsc -p server/contact/tsconfig.json",
    "check:contact:contract": "ASTRO_TELEMETRY_DISABLED=1 astro check --root tests/fixtures/contact",
    "build:contact:contract": "ASTRO_TELEMETRY_DISABLED=1 astro build --root tests/fixtures/contact",
    "test:contact": "node --experimental-strip-types --test tests/contact-*.test.ts",
    "test:e2e:contact:contract": "playwright test --config=playwright.contact.config.ts",
    "test:e2e:contact:service": "playwright test --config=playwright.contact.service.config.ts",
    "test:e2e:contact:integration": "PRIVA_TEST_MODE=integration playwright test --config=playwright.contact.config.ts",
    "test:admin": "node --experimental-strip-types --test tests/admin-*.test.ts",
    "check:admin:service": "tsc -p server/admin/tsconfig.json",
    "check:admin:contract": "ASTRO_TELEMETRY_DISABLED=1 astro check --root tests/fixtures/admin",
    "build:admin:contract": "ASTRO_TELEMETRY_DISABLED=1 astro build --root tests/fixtures/admin",
    "build:admin:views:local": "ASTRO_TELEMETRY_DISABLED=1 astro build --root server/admin/views",
    "test:e2e:admin:contract": "playwright test --config=playwright.admin.config.ts",
    "test:e2e:admin:service": "playwright test --config=playwright.admin.service.config.ts",
    "test:e2e:admin:integration": "PRIVA_TEST_MODE=integration playwright test --config=playwright.admin.config.ts",
    "build:admin:views": "node scripts/require-admin-publication.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build --root server/admin/views",
    "check:story-management:service": "tsc -p server/stories/tsconfig.json",
    "test:story-management": "node --experimental-strip-types --test tests/story-management-*.test.ts",
    "check:story-management:contract": "ASTRO_TELEMETRY_DISABLED=1 astro check --root tests/fixtures/story-management",
    "build:story-management:contract": "ASTRO_TELEMETRY_DISABLED=1 astro build --root tests/fixtures/story-management",
    "test:e2e:story-management:contract": "playwright test --config=playwright.story-management.config.ts",
    "test:e2e:story-management:service": "playwright test --config=playwright.story-management.service.config.ts",
    "test:e2e:story-management:integration": "PRIVA_TEST_MODE=integration playwright test --config=playwright.story-management.service.config.ts",
    "check:inbox:service": "tsc -p server/inbox/tsconfig.json",
    "test:inbox": "node --experimental-strip-types --test tests/inbox-*.test.ts",
    "check:inbox:contract": "ASTRO_TELEMETRY_DISABLED=1 astro check --root tests/fixtures/inbox",
    "build:inbox:contract": "ASTRO_TELEMETRY_DISABLED=1 astro build --root tests/fixtures/inbox",
    "test:e2e:inbox:contract": "playwright test --config=playwright.inbox.config.ts",
    "test:e2e:inbox:service": "playwright test --config=playwright.inbox.service.config.ts",
    "test:e2e:inbox:integration": "PRIVA_TEST_MODE=integration playwright test --config=playwright.inbox.service.config.ts",
    "check:privacy:service": "tsc -p server/privacy/tsconfig.json",
    "test:privacy": "node --experimental-strip-types --test --test-concurrency=2 tests/privacy-*.test.ts",
    "test:e2e:privacy:service": "playwright test --config=playwright.privacy.service.config.ts",
    "check:documents:contract": "ASTRO_TELEMETRY_DISABLED=1 astro check --root tests/fixtures/documents",
    "build:documents:contract": "ASTRO_TELEMETRY_DISABLED=1 astro build --root tests/fixtures/documents",
    "test:documents": "node --experimental-strip-types --test tests/documents-*.test.ts",
    "test:e2e:documents:contract": "playwright test --config=playwright.documents.config.ts",
    "test:e2e:documents:integration": "PRIVA_TEST_MODE=integration playwright test --config=playwright.documents.config.ts"
  },
  "dependencies": {
    "astro": "7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
