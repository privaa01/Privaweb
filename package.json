{
  "name": "privaweb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "node scripts/require-pages.mjs && node scripts/require-home-publication.mjs && node scripts/require-stories-publication.mjs && node scripts/require-app-publication.mjs && node scripts/require-contact-publication.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check:contract": "ASTRO_TELEMETRY_DISABLED=1 astro check --root tests/fixtures/navigation",
    "build:contract": "ASTRO_TELEMETRY_DISABLED=1 astro build --root tests/fixtures/navigation",
    "test:e2e:contract": "playwright test",
    "test:e2e:integration": "PRIVA_TEST_MODE=integration playwright test",
    "check:home:contract": "ASTRO_TELEMETRY_DISABLED=1 astro check --root tests/fixtures/home",
    "build:home:contract": "ASTRO_TELEMETRY_DISABLED=1 astro build --root tests/fixtures/home",
    "test:e2e:home:contract": "playwright test --config=playwright.home.config.ts",
    "test:e2e:home:integration": "PRIVA_TEST_MODE=integration playwright test --config=playwright.home.config.ts",
    "check:stories:contract": "ASTRO_TELEMETRY_DISABLED=1 astro check --root tests/fixtures/stories",
    "build:stories:contract": "ASTRO_TELEMETRY_DISABLED=1 astro build --root tests/fixtures/stories",
    "test:e2e:stories:contract": "playwright test --config=playwright.stories.config.ts",
    "test:e2e:stories:integration": "PRIVA_TEST_MODE=integration playwright test --config=playwright.stories.config.ts",
    "check:app:contract": "ASTRO_TELEMETRY_DISABLED=1 astro check --root tests/fixtures/app",
    "build:app:contract": "ASTRO_TELEMETRY_DISABLED=1 astro build --root tests/fixtures/app",
    "test:e2e:app:contract": "playwright test --config=playwright.app.config.ts",
    "test:e2e:app:integration": "PRIVA_TEST_MODE=integration playwright test --config=playwright.app.config.ts",
    "check:contact:service": "tsc -p server/contact/tsconfig.json",
    "check:contact:contract": "ASTRO_TELEMETRY_DISABLED=1 astro check --root tests/fixtures/contact",
    "build:contact:contract": "ASTRO_TELEMETRY_DISABLED=1 astro build --root tests/fixtures/contact",
    "test:contact": "node --experimental-strip-types --test tests/contact-*.test.ts",
    "test:e2e:contact:contract": "playwright test --config=playwright.contact.config.ts",
    "test:e2e:contact:service": "playwright test --config=playwright.contact.service.config.ts",
    "test:e2e:contact:integration": "PRIVA_TEST_MODE=integration playwright test --config=playwright.contact.config.ts"
  },
  "dependencies": {
    "astro": "7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
