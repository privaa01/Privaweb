{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "./*.ts",
    "../../src/lib/admin-*.ts",
    "../../src/config/admin.ts",
    "../../src/content/admin.ts",
    "../../tests/admin-*.test.ts",
    "../../tests/fixtures/admin-service/*.ts"
  ]
}
