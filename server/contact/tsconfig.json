{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "./**/*.ts",
    "../../src/lib/contact-contract.ts",
    "../../src/lib/contact-validation.ts",
    "../../tests/contact-*.test.ts",
    "../../tests/fixtures/contact-service/*.ts"
  ]
}
