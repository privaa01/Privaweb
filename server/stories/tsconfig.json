{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "./*.ts",
    "../../src/lib/story-management-*.ts",
    "../../tests/story-management-*.test.ts",
    "../../tests/fixtures/story-management-service/*.ts"
  ]
}
