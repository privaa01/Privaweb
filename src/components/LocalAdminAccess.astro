<a class="local-admin-access" href="/admin/login.html">Entrar al panel administrativo</a>
<script is:inline>
  // En desarrollo conserva el acceso al servidor administrativo local.
  if (['localhost', '127.0.0.1', '[::1]'].includes(window.location.hostname)) {
    document.querySelectorAll('.local-admin-access').forEach(link => {
      link.href = 'https://localhost:4354/admin/login';
    });
  }
</script>
<style>
  .local-admin-access { display: inline-flex; align-items: center; min-height: 44px; padding: .65rem 1rem; border: 1px solid currentColor; border-radius: 999px; color: inherit; margin: 0; }
</style>
