---
import AdminBrand from './AdminBrand.astro';
import {adminContent as content} from '../../content/admin';
---
<main class="admin-auth admin-login"><AdminBrand/><h1>{content.welcome}</h1><p>{content.introduction}</p>
<form data-admin-login method="post" novalidate><label class="admin-visually-hidden" for="admin-email">Correo</label><div class="login-input"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="7.5" r="3.5"/><path d="M5 20v-2a5 5 0 0 1 5-5h4a5 5 0 0 1 5 5v2a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1Z"/></svg><input id="admin-email" name="email" type="email" placeholder="Correo" autocomplete="username" required aria-describedby="email-error"/></div><small id="email-error" data-error="email"></small>
<label class="admin-visually-hidden" for="admin-password">Contraseña</label><div class="password-field login-input"><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="2.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><circle cx="12" cy="15" r=".8"/><path d="M12 15.8V18"/></svg><input id="admin-password" name="password" type="password" placeholder="Contraseña" autocomplete="current-password" required aria-describedby="password-error"/><button type="button" data-toggle data-icon-toggle aria-label="Mostrar contraseña" aria-pressed="false"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12Z"/><circle cx="12" cy="12" r="2.75"/><path data-eye-slash d="m3 3 18 18"/></svg></button></div><small id="password-error" data-error="password"></small>
<button type="submit" disabled>Entrar <svg class="login-submit-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></button><p role="status" aria-live="polite" data-feedback></p></form>
<a href="/admin/recuperar">Recuperar contraseña</a><noscript><p>Activa JavaScript para iniciar sesión. No se enviarán credenciales por URL.</p></noscript></main>
<script>import '../../scripts/admin-login';</script>
