---
import {adminContent} from '../../content/admin';
---
<main class="admin-auth"><a class="admin-brand" href="/">Priva</a><h1>Restablecer contraseña</h1><p id="password-policy">{adminContent.passwordPolicy}</p><form data-admin-reset method="post" novalidate><label for="new-password">Contraseña nueva</label><div class="password-field"><input id="new-password" name="password" type="password" autocomplete="new-password" required aria-describedby="password-policy reset-password-error"/><button type="button" data-toggle aria-label="Mostrar contraseña" aria-pressed="false">Mostrar</button></div><small id="reset-password-error" data-error="password"></small><button type="submit" disabled>Cambiar contraseña</button><p role="status" aria-live="polite" data-feedback></p></form><p><a href="/admin/recuperar">Solicitar un nuevo enlace</a></p><a href="/admin/login">Volver al acceso</a><noscript><p>Activa JavaScript para cambiar la contraseña. Abrir esta página no la cambia.</p></noscript></main><script>import '../../scripts/admin-reset';</script>
