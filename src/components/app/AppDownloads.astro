---
import type {AppData} from '../../content/app';
import type {EffectiveDownload} from '../../lib/app-downloads';
interface Props{content:AppData['downloads'];downloads:readonly EffectiveDownload[]}
const {content,downloads}=Astro.props;
---
<section id={content.id} class="app-download-section" data-app-block="downloads"><div class="app-section app-split"><div><p class="app-eyebrow">{content.eyebrow}</p><h2 tabindex="-1">{content.title}</h2><p>{content.description}</p><div class="app-platforms">{downloads.map(item=><div class="app-platform" data-platform={item.platform}><h3>{item.platform==='android'?'Android':'iPhone'}</h3>{item.state==='available'?<a class="app-link app-primary" href={item.href}>{item.label}</a>:<p class="app-pending">{item.label}</p>}</div>)}</div><p data-download-note>{content.note}</p></div><img src={content.image.src} alt={content.image.alt} width={content.image.width} height={content.image.height} loading="lazy" /></div></section>
