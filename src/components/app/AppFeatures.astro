---
import type {AppData} from '../../content/app';
interface Props{content:AppData['features']}
const {content}=Astro.props;
---
<section class="app-section" data-app-block="features"><h2>{content.title}</h2><p>{content.description}</p><div class="app-features">{content.items.map(item=><div data-feature><h3>{item.title}</h3><p>{item.description}</p></div>)}</div></section>
