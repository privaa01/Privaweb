---
import type { HomeData } from '../../content/home';
interface Props { content: HomeData['areas'] }
const { content } = Astro.props;
// Decorative icons follow PDF 1: book, envelope, bookmark and community.
const iconPaths = [
 'M12 5v15m0-15C9 3 5 3 2 4v15c3-1 7-1 10 1 3-2 7-2 10-1V4c-3-1-7-1-10 1Z',
 'M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Zm-2 2 10 7L22 7',
 'M5 21V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v17l-7-4-7 4Z',
 'M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 10v-3a5 5 0 0 1 5-5h4a5 5 0 0 1 5 5v3M17 3a4 4 0 0 1 0 8m2 3a5 5 0 0 1 3 4v3',
];
---
<section id={content.id} class="home-section home-areas" aria-labelledby="areas-title"><div class="home-row">
<div class="home-copy"><p class="home-eyebrow">{content.eyebrow}</p><h2 id="areas-title" tabindex="-1">{content.title}</h2><p>{content.description}</p></div>
<div class="home-cards">{content.cards.map((card, index) => <article class="home-card"><span class="home-card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d={iconPaths[index]} /></svg></span><h3>{card.title}</h3><p>{card.description}</p></article>)}</div>
</div></section>
