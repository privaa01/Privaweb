---
import type { Block } from '../../content/home';
interface Props { content: Block }
const { content } = Astro.props;
---
<section id={content.id} class="home-section home-closing" aria-labelledby="closing-title"><div class="home-row">
<div class="home-copy"><p class="home-eyebrow">{content.eyebrow}</p><h2 id="closing-title">{content.title}</h2><p>{content.description}</p><a href="/historias.html" class="home-button">Explora nuestras historias <span aria-hidden="true">→</span></a></div>
<div class="home-visual"><img src={content.image.src} alt={content.image.alt} width={content.image.width} height={content.image.height} loading="lazy" decoding="async" /></div>
</div></section>
