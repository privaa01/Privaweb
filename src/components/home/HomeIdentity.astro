---
import type { Block } from '../../content/home';
interface Props { content: Block }
const { content } = Astro.props;
---
<section id={content.id} class="home-section home-identity" aria-labelledby="identity-title"><div class="home-row home-row-identity">
<div class="home-visual"><img src={content.image.src} alt={content.image.alt} width={content.image.width} height={content.image.height} loading="lazy" decoding="async" /></div>
<div class="home-copy"><p class="home-eyebrow">{content.eyebrow}</p><h2 id="identity-title" tabindex="-1">{content.title}</h2><p>{content.description}</p></div>
</div></section>
