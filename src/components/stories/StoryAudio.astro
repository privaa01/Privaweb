<div class="story-audio">
  <div data-file-player><audio controls preload="metadata" data-audio></audio></div>
  <div data-spotify-player hidden>
    <button type="button" data-load-spotify>Cargar reproductor de Spotify</button>
    <div data-spotify-frame></div>
    <p><a data-spotify-link target="_blank" rel="noopener noreferrer">Abrir episodio en Spotify</a></p>
  </div>
  <p data-audio-status role="status" aria-live="polite">Cargando audio…</p><p>Duración: <span data-audio-duration>Sin metadatos</span></p><details><summary>Leer transcripción</summary><p data-story-transcript></p></details>
</div>
