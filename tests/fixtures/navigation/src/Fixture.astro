---
import PublicLayout from '../../../../src/layouts/PublicLayout.astro';
import type { PageId } from '../../../../src/config/navigation';
interface Props { pageId: PageId; title: string; section?: string }
const { pageId, title, section } = Astro.props;
---
<PublicLayout pageId={pageId} title={title}>
<p>Banco de pruebas de navegación; contenido ficticio, no publicable.</p>
<h1>{title}</h1>
{section && <section id={section}><h2 tabindex="-1">{section}</h2><p>Destino de prueba sin servicio ni contenido oficial.</p></section>}
</PublicLayout>
